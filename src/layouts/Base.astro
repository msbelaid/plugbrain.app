---
import '@fontsource-variable/lexend';
// Arabic glyphs. Its @font-face rules only match Arabic characters, so other pages never download it.
import '@fontsource-variable/readex-pro/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getStrings, dirFor, homeFor, languages, defaultLocale } from '../i18n';
import lexendLatin from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import readexArabic from '@fontsource-variable/readex-pro/files/readex-pro-arabic-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** Page-specific schema.org nodes, added to the site-wide graph. */
  schema?: Record<string, unknown>[];
  /** The page exists in every language (the home page), so link the translations for search engines. */
  translated?: boolean;
  /** Translations of this page that aren't the home page: { locale: path }. */
  alternates?: Record<string, string>;
  /** og:type, "website" by default; garden stories are articles. */
  ogType?: string;
  /** Share image (1200×630) in place of the site-wide og.png. */
  image?: { src: string; alt: string };
}
const locale = Astro.currentLocale ?? 'en';
const t = getStrings(locale);
const { title = t.meta.title, description = t.meta.description, noindex = false, schema = [], translated = false, alternates = {}, ogType = 'website', image } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image?.src ?? '/og.png', site);
const ogAlt = image?.alt ?? t.meta.imageAlt;
const ogSize = image ? [1200, 630] : [1024, 500];
const ogLocale = ({ en: 'en_US', fr: 'fr_FR', ar: 'ar_AR' } as Record<string, string>)[locale] ?? locale;

// Site-wide structured data. Pages add their own nodes (the app, the FAQ) via `schema`.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).href,
      url: site.href,
      name: 'PlugBrain',
      description: t.meta.description,
      inLanguage: locale,
      publisher: { '@id': new URL('/#author', site).href },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#author', site).href,
      name: 'Mohammed-Said Belaid',
      url: 'https://github.com/msbelaid',
    },
    ...schema,
  ],
};
---
<!doctype html>
<html lang={locale} dir={dirFor(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    {translated && Object.keys(languages).map((l) => <link rel="alternate" hreflang={l} href={new URL(homeFor(l), site)} />)}
    {translated && <link rel="alternate" hreflang="x-default" href={new URL(homeFor(defaultLocale), site)} />}
    {Object.entries(alternates).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p, site)} />)}
    {alternates[defaultLocale] && <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLocale], site)} />}
    <slot name="head" />
    <link rel="preload" href={lexendLatin} as="font" type="font/woff2" crossorigin />
    {locale === 'ar' && <link rel="preload" href={readexArabic} as="font" type="font/woff2" crossorigin />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#001824" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="PlugBrain" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={ogSize[0]} />
    <meta property="og:image:height" content={ogSize[1]} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {/* Cookie-free, open-source visit counter (GoatCounter). No personal data; see /privacy/. */}
    <script is:inline data-goatcounter="https://plugbrain.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Fade sections in as they scroll into view.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
