---
import '@fontsource-variable/lexend';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getStrings, dirFor } from '../i18n';
import lexendLatin from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** Page-specific schema.org nodes, added to the site-wide graph. */
  schema?: Record<string, unknown>[];
}
const locale = Astro.currentLocale ?? 'en';
const t = getStrings(locale);
const { title = t.meta.title, description = t.meta.description, noindex = false, schema = [] } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og.png', site);
const ogLocale = ({ en: 'en_US' } as Record<string, string>)[locale] ?? locale;

// Site-wide structured data. Pages add their own nodes (the app, the FAQ) via `schema`.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).href,
      url: site.href,
      name: 'PlugBrain',
      description: t.meta.description,
      inLanguage: locale,
      publisher: { '@id': new URL('/#author', site).href },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#author', site).href,
      name: 'Mohammed-Said Belaid',
      url: 'https://github.com/msbelaid',
    },
    ...schema,
  ],
};
---
<!doctype html>
<html lang={locale} dir={dirFor(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href={lexendLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#001824" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="PlugBrain" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content="PlugBrain: Solve a little math. Scroll a lot less." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="PlugBrain: Solve a little math. Scroll a lot less." />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Fade sections in as they scroll into view.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
