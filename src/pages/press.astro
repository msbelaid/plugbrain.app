---
// Press kit. English only for now. Files live in public/press/; the ZIP is built after `astro build`
// by scripts/press-zip.sh (npm "postbuild"), so it always holds the same files this page lists.
import Base from '../layouts/Base.astro';
import { links } from '../data/links';

const email = 'belaid.mohammed.said@gmail.com';
const base = '/press';
const languageCount = 13;

const facts: [string, string][] = [
  ['Name', 'PlugBrain'],
  ['What it is', 'An Android app that blocks distracting apps until you solve a quick math challenge'],
  ['Price', 'Free. No ads, no in-app purchases'],
  ['Platform', 'Android 9 and later'],
  ['License', 'Free and open source (GPL-3.0)'],
  ['Languages', `${languageCount}, including English, Arabic, French, Spanish, German and Portuguese`],
  ['Privacy', 'No internet permission, no account, no data collected'],
  ['First release', 'June 2025 on GitHub; F-Droid in July 2025, Google Play in October 2025'],
  ['Made by', 'Mohammed-Said Belaid and contributors from around the world'],
  ['Based in', 'Oran, Algeria'],
];

const descriptions = [
  {
    id: 'one-line',
    label: 'One line',
    text: 'PlugBrain is a free, open-source Android app that blocks distracting apps until you solve a quick math challenge.',
  },
  {
    id: 'short',
    label: 'Short (about 50 words)',
    text: `PlugBrain is a free, open-source Android app that puts a short math problem between you and the apps that eat your time. The more often you go back, the harder the math gets; stay away and it gets easier again. No ads, no account, no internet permission. Available in ${languageCount} languages.`,
  },
  {
    id: 'long',
    label: 'Long (about 150 words)',
    text: `PlugBrain is a free, open-source Android app that helps people spend less time on the apps that distract them. You choose the apps, such as social media or games, and how often PlugBrain should step in. When it's time, the app pauses and a math challenge appears. Solve it and carry on.

The challenges adapt to how you use your phone. The more often you go back to a blocked app, the harder the math gets. Stay away longer and it gets easier again. About 40 kinds of challenges cover addition, subtraction, multiplication, squares and equations with a missing number.

That short pause is the point: it breaks the automatic reach for the phone and leaves the choice to you. PlugBrain has no ads, needs no account and has no internet permission, so nothing leaves the phone. It is available on Google Play, F-Droid and IzzyOnDroid in ${languageCount} languages.`,
  },
];

const features = [
  ['A math challenge, not a timer', 'You can tap past a timer without thinking. A math problem makes you stop for a few seconds and decide if you really want to open the app.'],
  ['Difficulty that adapts', 'The more often you go back, the harder the math gets. Stay away and it gets easier again.'],
  ['About 40 kinds of challenges', 'From simple addition to multiplication, squares and equations with a missing number. A little mental math practice comes as a bonus.'],
  ['You set the rules', 'Pick the apps to block, how often a challenge appears, and the difficulty to start from.'],
  ['Private by design', 'No internet permission, no account, no ads, no tracking. Everything stays on the phone.'],
  ['Free and open source', 'GPL-3.0 on GitHub. Listed on F-Droid, which checks the code and found no anti-features.'],
];

const quotes = [
  "I didn't want a total ban. Bans make you want to get around them. A small math problem gives you a few seconds to ask yourself: do I really need this app right now?",
  'An app that helps you spend less time on your phone should never earn money from the time you spend on it. That is why PlugBrain has no ads, no account and no internet access.',
  'PlugBrain started as a teaching example. Then people I had never met, from all over the world, began translating it, designing it and improving the code. It is not only my project anymore.',
];

const logos = [
  { file: 'plugbrain-light', label: 'For light backgrounds', bg: 'light' },
  { file: 'plugbrain-dark', label: 'For dark backgrounds', bg: 'dark' },
  { file: 'plugbrain-light-mono', label: 'Black, for light backgrounds', bg: 'light' },
  { file: 'plugbrain-dark-mono', label: 'White, for dark backgrounds', bg: 'dark' },
  { file: 'plugbrain-light-square', label: 'Square tile, light', bg: 'none' },
  { file: 'plugbrain-dark-square', label: 'Square tile, dark', bg: 'none' },
];

const graphics = [
  { file: 'plugbrain-banner-1920x1080.png', label: 'Banner, 1920 × 1080' },
  { file: 'plugbrain-banner-1280x640.png', label: 'Banner, 1280 × 640' },
  { file: 'plugbrain-banner-1024x500.png', label: 'Banner, 1024 × 500' },
  { file: 'plugbrain-banner-light-1024x500.png', label: 'Light banner, 1024 × 500' },
];

const screenshots = [
  ['plugbrain-1-welcome.png', 'Welcome screen'],
  ['plugbrain-2-choose-apps.png', 'Choosing the apps to block'],
  ['plugbrain-3-home.png', 'Home screen'],
  ['plugbrain-4-challenge.png', 'A math challenge'],
  ['plugbrain-5-interval.png', 'How often to challenge'],
  ['plugbrain-6-difficulty.png', 'Starting difficulty'],
  ['plugbrain-7-dark-mode.png', 'Dark mode'],
];

const coverage = [
  { outlet: 'Valley4Techs', title: 'PlugBrain app review (English)', url: 'https://en.valley4techs.com/2026/11/plugbrain-app-review.html' },
  { outlet: 'Valley4Techs', title: 'PlugBrain app review (Arabic)', url: 'https://www.valley4techs.com/2026/11/plugbrain-app-review.html' },
];

---
<Base
  title="Press kit · PlugBrain"
  description="Facts, descriptions, the story, logos, screenshots and contact details for writing about PlugBrain, the free Android app that blocks distracting apps with math challenges."
>
  <article class="wrap press">
    <a class="back" href="/">← PlugBrain</a>
    <header class="intro">
      <h1>Press kit</h1>
      <p class="lead">Everything you need to write about PlugBrain. All text and images on this page are free to use in articles, reviews and videos about the app.</p>
      <div class="actions">
        <a class="btn primary" href={`${base}/plugbrain-press-kit.zip`} download>Download everything (ZIP)</a>
        <a class="btn" href={`${base}/plugbrain-fact-sheet.pdf`} download>Fact sheet (PDF)</a>
        <a class="btn" href={`mailto:${email}?subject=PlugBrain%20press`}>Contact</a>
      </div>
    </header>

    <nav class="toc" aria-label="On this page">
      <a href="#facts">Facts</a>
      <a href="#descriptions">Descriptions</a>
      <a href="#story">Story</a>
      <a href="#features">Features</a>
      <a href="#quotes">Quotes</a>
      <a href="#logos">Logos</a>
      <a href="#screenshots">Screenshots</a>
      <a href="#contact">Contact</a>
    </nav>

    <section id="facts">
      <h2>Quick facts</h2>
      <dl class="facts">
        {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        <div>
          <dt>Get it</dt>
          <dd>
            <a href={links.play}>Google Play</a> · <a href={links.fdroid}>F-Droid</a> · <a href={links.izzy}>IzzyOnDroid</a> · <a href={links.apk}>APK on GitHub</a>
          </dd>
        </div>
        <div><dt>Links</dt><dd><a href="https://plugbrain.app">plugbrain.app</a> · <a href={links.github}>Source code</a> · <a href={links.reddit}>r/PlugBrain</a></dd></div>
      </dl>
    </section>

    <section id="descriptions">
      <h2>Descriptions</h2>
      <p class="note">Copy the one that fits your space.</p>
      {descriptions.map((d) => (
        <div class="card copyable">
          <div class="card-head">
            <h3>{d.label}</h3>
            <button type="button" class="copy" data-copy={d.id}>Copy</button>
          </div>
          <div id={`desc-${d.id}`} class="copy-text">
            {d.text.split('\n\n').map((p) => <p>{p}</p>)}
          </div>
        </div>
      ))}
    </section>

    <section id="story">
      <h2>The story</h2>
      <p>PlugBrain began in 2025 as the hands-on example in an Android development training for students at the Khaldounia cultural association in Oran, Algeria, led by Mohammed-Said Belaid. The idea was to show how a real app is built, step by step, with the care a large project needs.</p>
      <p>Once the code was published as open source, the example grew beyond the classroom. People started using it and sending feedback, and developers, translators and designers from around the world began to contribute. Algerian designer Hichem Dahaoui redesigned the interface, Australian designer Travis Jeans drew the logo, and volunteers translated the app into {languageCount} languages.</p>
      <p>Today PlugBrain is available on Google Play, F-Droid and IzzyOnDroid, and it is still free, open source and without ads.</p>
    </section>

    <section id="features">
      <h2>Key features</h2>
      <ul class="features">
        {features.map(([title, body]) => (<li><h3>{title}</h3><p>{body}</p></li>))}
      </ul>
    </section>

    <section id="quotes">
      <h2>Quotes</h2>
      <p class="note">From Mohammed-Said Belaid, the developer of PlugBrain.</p>
      {quotes.map((q) => (<blockquote><p>“{q}”</p></blockquote>))}
    </section>

    <section id="logos">
      <h2>Logos</h2>
      <p class="note">Please don't change the colors or proportions of the logo. Icon by Travis Jeans.</p>
      <ul class="grid logos">
        {logos.map((l) => (
          <li>
            <div class={`thumb logo-thumb bg-${l.bg}`}><img src={`${base}/logo/${l.file}.svg`} alt={`PlugBrain logo, ${l.label.toLowerCase()}`} width="96" height="96" loading="lazy" /></div>
            <p class="label">{l.label}</p>
            <p class="dl"><a href={`${base}/logo/${l.file}.svg`} download>SVG</a> · <a href={`${base}/logo/${l.file}-1920.png`} download>PNG 1920</a></p>
          </li>
        ))}
        <li>
          <div class="thumb logo-thumb bg-none"><img src={`${base}/logo/plugbrain-app-icon-512.png`} alt="PlugBrain app icon" width="96" height="96" loading="lazy" /></div>
          <p class="label">App icon</p>
          <p class="dl"><a href={`${base}/logo/plugbrain-app-icon-512.png`} download>PNG 512</a></p>
        </li>
      </ul>
      <h3 class="sub">Colors</h3>
      <ul class="swatches">
        <li><span style="background:#20DFD9"></span>Teal #20DFD9</li>
        <li><span style="background:#004852"></span>Dark green #004852</li>
        <li><span style="background:#001824"></span>Navy #001824</li>
        <li><span style="background:#ADFEFD"></span>Cyan #ADFEFD</li>
        <li><span style="background:#F9F5F4"></span>Beige #F9F5F4</li>
      </ul>
      <p class="note">The name is written PlugBrain: one word, capital P and capital B. The typeface on the site and banners is Lexend.</p>

      <h3 class="sub">Banners and demo</h3>
      <ul class="grid banners">
        {graphics.map((g) => (
          <li>
            <a class="thumb" href={`${base}/graphics/${g.file}`} download><img src={`${base}/graphics/${g.file}`} alt={`PlugBrain ${g.label.toLowerCase()}`} loading="lazy" /></a>
            <p class="label">{g.label}</p>
          </li>
        ))}
        <li>
          <a class="thumb" href={`${base}/graphics/plugbrain-demo.gif`} download><img src={`${base}/graphics/plugbrain-demo.gif`} alt="Animation: the math challenges get harder the more you use a blocked app" loading="lazy" /></a>
          <p class="label">Animated demo (GIF)</p>
        </li>
      </ul>
    </section>

    <section id="screenshots">
      <h2>Screenshots</h2>
      <p class="note">Real screenshots of PlugBrain 1.6 in English, 1080 × 2340. Click one to download it.</p>
      <ul class="grid shots">
        {screenshots.map(([file, label]) => (
          <li>
            <a class="thumb shot" href={`${base}/screenshots/${file}`} download><img src={`${base}/screenshots/${file}`} alt={`PlugBrain screenshot: ${label.toLowerCase()}`} width="1080" height="2340" loading="lazy" /></a>
            <p class="label">{label}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="coverage">
      <h2>Coverage</h2>
      <ul class="coverage">
        {coverage.map((c) => (<li><a href={c.url}>{c.title}</a> <span>{c.outlet}</span></li>))}
      </ul>
    </section>

    <section id="credits">
      <h2>Credits</h2>
      <ul class="credits">
        <li><strong>Mohammed-Said Belaid</strong>, developer and maintainer (<a href="https://github.com/msbelaid">GitHub</a>)</li>
        <li><strong>Hichem Dahaoui</strong>, interface design (<a href="https://github.com/HichemDahaoui">GitHub</a>)</li>
        <li><strong>Travis Jeans</strong>, logo and app icon (<a href="https://github.com/travis-jeans">GitHub</a>)</li>
        <li>Translators and code contributors from around the world, listed on <a href={`${links.github}/graphs/contributors`}>GitHub</a></li>
      </ul>
    </section>

    <section id="contact" class="contact card">
      <h2>Contact</h2>
      <p>For interviews, questions or a review build, write to Mohammed-Said Belaid at <a href={`mailto:${email}?subject=PlugBrain%20press`}>{email}</a>. Interviews are possible in English, French and Arabic.</p>
    </section>
  </article>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    button.addEventListener('click', async () => {
      const el = document.getElementById(`desc-${button.dataset.copy}`);
      if (!el) return;
      const text = [...el.querySelectorAll('p')].map((p) => p.textContent?.trim()).join('\n\n');
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        // Clipboard blocked: select the text so it can be copied by hand.
        const range = document.createRange();
        range.selectNodeContents(el);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
        button.textContent = 'Selected';
      }
      setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
  }
</script>

<style>
  .press { max-width: 960px; padding-top: 56px; padding-bottom: 96px; }
  .back { display: inline-block; margin-bottom: 28px; text-decoration: none; font-size: 15px; }
  h1 { font-size: clamp(36px, 5vw, 52px); }
  .lead { font-size: 19px; color: var(--muted); max-width: 640px; margin: 12px 0 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .btn { display: inline-flex; align-items: center; padding: 12px 20px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--text); text-decoration: none; font-weight: 500; font-size: 15px; }
  .btn:hover { border-color: var(--accent); }
  .btn.primary { background: var(--green); border-color: var(--green); color: var(--beige); }
  .btn.primary:hover { background: var(--teal-700); }
  .toc { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 40px 0 0; padding: 14px 0; border-block: 1px solid var(--line); font-size: 15px; }
  .toc a { text-decoration: none; color: var(--muted); }
  .toc a:hover { color: var(--accent); }
  section { margin-top: 56px; scroll-margin-top: 90px; }
  h2 { font-size: 28px; margin-bottom: 16px; }
  h3 { font-size: 17px; }
  .sub { margin: 36px 0 14px; }
  .note { color: var(--muted); font-size: 15px; margin: -6px 0 18px; }
  section > p { max-width: 720px; }
  .facts { display: grid; margin: 0; border-top: 1px solid var(--line); }
  .facts div { display: grid; grid-template-columns: 180px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .facts dt { color: var(--muted); font-size: 15px; }
  .facts dd { margin: 0; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 24px; }
  .copyable + .copyable { margin-top: 14px; }
  .card-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 8px; }
  .card-head h3 { font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .copy { font: inherit; font-size: 14px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--accent); cursor: pointer; }
  .copy:hover { border-color: var(--accent); }
  .copy-text p { margin: 0 0 10px; }
  .copy-text p:last-child { margin-bottom: 0; }
  .features { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .features li { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; }
  .features p { margin: 8px 0 0; color: var(--muted); font-size: 15px; }
  blockquote { margin: 0 0 14px; padding: 4px 0 4px 20px; border-inline-start: 3px solid var(--teal); font-size: 18px; }
  blockquote p { margin: 0; }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; }
  .logos { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .banners { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .shots { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
  .thumb { display: grid; place-items: center; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); }
  .thumb img { display: block; width: 100%; height: auto; }
  .logo-thumb { aspect-ratio: 1; }
  .logo-thumb img { width: 96px; height: 96px; }
  .logo-thumb.bg-none img { width: 70%; height: auto; }
  .banners .thumb { aspect-ratio: 16 / 9; background: var(--bg-alt); }
  .banners .thumb img { width: 100%; height: 100%; object-fit: contain; }
  .bg-light { background: #f9f5f4; }
  .bg-dark { background: #001824; }
  .bg-none { background: repeating-conic-gradient(var(--bg-alt) 0 25%, var(--surface) 0 50%) 0 0 / 16px 16px; }
  .shot { border-radius: 12px; }
  .label { margin: 8px 0 0; font-size: 14px; }
  .dl { margin: 2px 0 0; font-size: 14px; }
  .swatches { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 15px; }
  .swatches li { display: flex; align-items: center; gap: 8px; }
  .swatches span { width: 22px; height: 22px; border-radius: 6px; border: 1px solid var(--line); }
  .coverage, .credits { padding-inline-start: 22px; display: grid; gap: 8px; }
  .coverage span { color: var(--muted); font-size: 14px; margin-inline-start: 6px; }
  .contact { margin-top: 56px; }
  .contact h2 { margin-bottom: 8px; }
  .contact p { margin: 0; }
  @media (max-width: 600px) {
    .facts div { grid-template-columns: 1fr; gap: 2px; }
    .card { padding: 18px; }
  }
</style>
