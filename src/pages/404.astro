---
import Base from '../layouts/Base.astro';
import { getStrings } from '../i18n';
const t = getStrings(Astro.currentLocale);
---
<Base title={`${t.notFound.title} · PlugBrain`} noindex>
  <section class="nf">
    <div class="wrap">
      <img src="/logo-dark.svg" width="120" height="120" alt="" />
      <h1>{t.notFound.title}</h1>
      <p>{t.notFound.text}</p>
      <a class="btn btn-primary" href="/">{t.notFound.back}</a>
    </div>
  </section>
</Base>
<style>
  .nf { background: var(--navy); color: var(--on-dark); text-align: center; padding: 120px 0 140px; }
  .nf img { margin: 0 auto 24px; }
  h1 { font-size: clamp(34px, 5vw, 52px); }
  p { color: var(--on-dark-muted); margin: 14px 0 32px; }
</style>
