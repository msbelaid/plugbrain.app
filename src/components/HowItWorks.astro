---
import Phone from './Phone.astro';
import { getStrings } from '../i18n';
import { apps, difficulty, challenge } from '../data/screens';
const t = getStrings(Astro.currentLocale);
const shots = [apps, difficulty, challenge];
---
<section class="section" id="how">
  <div class="wrap">
    <div class="center reveal">
      <p class="eyebrow">{t.how.eyebrow}</p>
      <h2>{t.how.title}</h2>
    </div>
    <ol class="steps">
      {t.how.steps.map((step, i) => (
        <li class="step reveal" style={`transition-delay:${i * 90}ms`}>
          <Phone src={shots[i]} alt={step.alt} width={240} />
          <div class="text">
            <span class="num">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps { list-style: none; margin: 64px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .step { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .step :global(.phone) { margin-bottom: 32px; }
  .num { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: var(--teal); color: var(--navy); font-weight: 700; margin-bottom: 14px; }
  .text p { color: var(--muted); margin: 10px auto 0; max-width: 32ch; }
  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr; gap: 64px; }
    .step { flex-direction: row; text-align: left; gap: 28px; align-items: center; }
    .step :global(.phone) { margin: 0; flex: 0 0 42%; }
    .text p { margin-left: 0; }
  }
  @media (max-width: 520px) {
    .step { flex-direction: column; text-align: center; }
    .step :global(.phone) { flex: none; width: 54%; }
    .text p { margin-left: auto; }
  }
</style>
