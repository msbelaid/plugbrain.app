---
import Base from '../../layouts/Base.astro';
import StageIcon from './StageIcon.astro';
import { Image } from 'astro:assets';
import { getStrings, languages, dirFor } from '../../i18n';
import { stories, stageOrder, formatDate, gardenHome, imageFor } from '../../data/garden';

const locale = Astro.currentLocale ?? 'en';
const t = getStrings(locale);
const g = t.garden;
const all = await stories(locale);
// Published stories, then only the next one to come (shown faded), so the plant grows week by week.
const published = all.filter((s) => s.published);
const next = all.find((s) => !s.published);
const shown = next ? [...published, next] : published;
const stages = stageOrder
  .map((stage) => ({ stage, items: shown.filter((s) => s.entry.data.stage === stage) }))
  .filter((s) => s.items.length);
// A story not yet translated keeps its own language and direction inside the page.
const foreign = (lang: string) => (lang === locale ? {} : { lang, dir: dirFor(lang) });
const alternates = Object.fromEntries(Object.keys(languages).map((l) => [l, gardenHome(l)]));
const schema = [{
  '@type': 'Blog',
  '@id': new URL(`${gardenHome(locale)}#blog`, Astro.site).href,
  name: g.title,
  description: g.metaDescription,
  inLanguage: locale,
  author: { '@id': new URL('/#author', Astro.site).href },
  blogPost: published.filter((s) => s.lang === locale).map((s) => ({
    '@type': 'BlogPosting',
    headline: s.entry.data.title,
    url: new URL(s.url, Astro.site).href,
    datePublished: s.entry.data.date.toISOString().slice(0, 10),
  })),
}];
---
<Base title={g.metaTitle} description={g.metaDescription} schema={schema} alternates={alternates}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={g.title} href={`${gardenHome(locale)}rss.xml`} />
  <div class="garden wrap">
    <header>
      <h1><StageIcon stage="seedling" size={56} />{g.title}</h1>
      <p class="sub">{g.intro}</p>
    </header>
    <ol class="tl">
      {stages.map(({ stage, items }) => (
        <li class="stage">
          <div class="stage-head"><StageIcon stage={stage} /><span>{g.stages[stage]}</span></div>
          <ol>
            {items.map((s) => (
              <li class:list={['story', { soon: !s.published }]}>
                <div class="text">
                  {s.published ? (
                    <>
                      <time datetime={s.entry.data.date.toISOString().slice(0, 10)}>{formatDate(s.entry.data.date, locale)}</time>
                      <a href={s.url} {...foreign(s.lang)}>{s.entry.data.title}</a>
                    </>
                  ) : (
                    <>
                      <span class="date">{g.coming.replace('{date}', formatDate(s.entry.data.date, locale, false))}</span>
                      <span class="title" {...foreign(s.lang)}>{s.entry.data.title}</span>
                    </>
                  )}
                </div>
                {imageFor(s.slug) && (
                  <Image class="thumb" src={imageFor(s.slug)!} alt="" widths={[200, 400]} sizes="(max-width: 600px) 96px, 200px" loading="lazy" />
                )}
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
    <p class="foot">{g.stillGrowing} <a href={`${gardenHome(locale)}rss.xml`}>{g.rss}</a></p>
  </div>
</Base>
<style>
  .garden { max-width: 820px; padding-top: 64px; padding-bottom: 96px; --g-muted: #5e9e9c; --stem: #8fc9c7; }
  h1 { display: flex; align-items: center; gap: 14px; font-size: clamp(32px, 5vw, 44px); font-weight: 500; letter-spacing: -0.5px; line-height: 1.15; margin: 0; }
  h1 :global(.stage-icon) { width: 1.3em; height: 1.3em; margin-inline-start: -0.15em; }
  .sub { color: var(--g-muted); font-weight: 300; font-size: 18px; margin: 10px 0 48px; }
  ol { list-style: none; margin: 0; padding: 0; }
  .tl { position: relative; }
  .stage { position: relative; padding-bottom: 8px; }
  .stage-head { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; }
  .stage-head span { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: var(--g-muted); font-weight: 500; }
  .stage > ol { position: relative; padding-inline-start: 64px; padding-bottom: 18px; }
  /* The stem: one line through every stage. */
  .stage > ol::before { content: ''; position: absolute; inset-inline-start: 23px; top: -8px; bottom: 0; width: 2px; background: linear-gradient(var(--stem), var(--g-muted)); }
  .story { position: relative; margin: 0 0 26px; display: flex; align-items: center; gap: 20px; }
  .text { flex: 1; min-width: 0; }
  .thumb { flex: none; width: 200px; height: auto; aspect-ratio: 1200 / 630; border-radius: 12px; border: 1px solid var(--line); }
  .story:has(a:hover) .thumb { border-color: var(--g-muted); }
  .story::before { content: ''; position: absolute; inset-inline-start: -46px; top: calc(50% - 7px); width: 10px; height: 10px; border-radius: 50%; background: var(--bg); border: 2px solid var(--text); }
  time, .date { display: block; font-size: 13px; color: var(--g-muted); font-weight: 300; }
  .story a, .story .title { display: block; font-size: 19px; font-weight: 500; color: var(--text); text-decoration: none; line-height: 1.35; margin-top: 2px; }
  .story a:hover { color: var(--accent); text-decoration: underline; }
  /* An English title on the French or Arabic page still lines up with the others. */
  .story [dir] { text-align: start; }
  :global([dir='rtl']) .story [dir='ltr'] { text-align: right; }
  .soon { opacity: 0.4; }
  .soon::before { border-style: dashed; }
  .foot { margin-top: 32px; font-size: 14px; color: var(--g-muted); font-weight: 300; }
  @media (prefers-color-scheme: dark) { .garden { --g-muted: #8fc9c7; --stem: #5e9e9c; } }
  @media (max-width: 600px) { .garden { padding-top: 40px; } .story { gap: 14px; } .story a, .story .title { font-size: 17px; } .thumb { width: 96px; border-radius: 8px; } }
</style>
