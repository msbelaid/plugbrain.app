---
// Line drawings of the plant at each growth stage, from the garden mockup.
import type { Stage } from '../../data/garden';
interface Props { stage: Stage; size?: number }
const { stage, size = 48 } = Astro.props;
---
<svg class="stage-icon" width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {stage === 'seed' && <ellipse cx="24" cy="31" rx="6" ry="4.5" />}
  {stage === 'sprout' && (<>
    <path d="M24 37V25" /><path d="M24 27c-6 0-8-4-8-7 4 0 8 2 8 7zM24 25c5 0 7-4 7-6-4 0-7 2-7 6z" />
  </>)}
  {stage === 'seedling' && (<>
    <path d="M24 37V16" /><path d="M24 30c-7 0-9-4-9-7 5 0 9 2 9 7zM24 24c6 0 8-4 8-7-5 0-8 2-8 7zM24 18c-4 0-5-3-5-5 3 0 5 1 5 5z" />
  </>)}
  {stage === 'sapling' && (<>
    <path d="M24 37V12" /><path d="M24 28l-7-6M24 22l7-6M24 31l6-4" />
    <path d="M17 22c-4 0-6-3-6-5 3 0 6 1 6 5zM31 16c4 0 6-3 6-5-3 0-6 1-6 5zM30 27c3 1 6-1 6-3-3-1-5 0-6 3zM24 12c-2-2-2-5 0-7 2 2 2 5 0 7z" />
  </>)}
  {(stage === 'youngTree' || stage === 'blossom' || stage === 'fruit') && (<>
    <path d="M24 37V22M24 28l-5-4M24 26l5-4" />
    <path d="M24 23c-9 0-13-4-13-9 0-6 6-10 13-10s13 4 13 10c0 5-4 9-13 9z" />
    {stage === 'blossom' && <><circle cx="18" cy="12" r="1.6" /><circle cx="28" cy="9" r="1.6" /><circle cx="30" cy="17" r="1.6" /></>}
    {stage === 'fruit' && <><circle cx="18" cy="15" r="2.4" /><circle cx="29" cy="12" r="2.4" /></>}
  </>)}
  <path d="M13 38h22" class="ground" />
</svg>
<style>
  .stage-icon { color: var(--text); flex: none; }
  .ground { stroke: var(--g-muted, #5e9e9c); }
</style>
