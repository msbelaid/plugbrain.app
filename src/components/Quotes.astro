---
import Icon from './Icon.astro';
import { getStrings } from '../i18n';
const t = getStrings(Astro.currentLocale);
---
<section class="section" id="reviews">
  <div class="wrap">
    <div class="center reveal">
      <p class="eyebrow">{t.quotes.eyebrow}</p>
      <h2>{t.quotes.title}</h2>
    </div>
    <ul class="quotes">
      {t.quotes.items.map((q, i) => (
        <li class="reveal" style={`transition-delay:${(i % 2) * 80}ms`}>
          <figure>
            <Icon name="quote" size={28} class="mark" />
            <blockquote>{q.text}</blockquote>
            <figcaption>{'href' in q && q.href ? <a href={q.href}>{q.who}</a> : q.who}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .quotes { list-style: none; margin: 56px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  figure { margin: 0; height: 100%; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px 30px; display: flex; flex-direction: column; }
  figure :global(.mark) { color: var(--teal-600); margin-bottom: 12px; }
  blockquote { margin: 0; font-size: 19px; line-height: 1.5; letter-spacing: -0.005em; flex: 1; }
  figcaption { margin-top: 18px; font-size: 14px; color: var(--muted); font-weight: 500; }
  figcaption a { color: var(--muted); }
  @media (max-width: 800px) { .quotes { grid-template-columns: 1fr; } blockquote { font-size: 18px; } }
</style>
