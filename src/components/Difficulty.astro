---
import Phone from './Phone.astro';
import Icon from './Icon.astro';
import { getStrings } from '../i18n';
import { home } from '../data/screens';
const t = getStrings(Astro.currentLocale);
const d = t.difficulty;
---
<section class="section teal" id="difficulty">
  <div class="wrap grid">
    <div class="copy reveal">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2>{d.title}<br /><span>{d.titleB}</span></h2>
      <p class="lead">{d.lead}</p>
      <div class="stairs" role="list">
        {d.levels.map((l) => (
          <div class="stair" role="listitem" style={`--h:${l.level / 15}`}>
            <span class="eq">{l.eq}</span>
            <span class="bar"></span>
            <span class="lbl">{l.label}</span>
          </div>
        ))}
      </div>
      <div class="rules">
        <div class="rule"><span class="ic up"><Icon name="up" size={18} /></span><div><strong>{d.up.title}</strong><p>{d.up.text}</p></div></div>
        <div class="rule"><span class="ic down"><Icon name="down" size={18} /></span><div><strong>{d.down.title}</strong><p>{d.down.text}</p></div></div>
      </div>
    </div>
    <div class="visual reveal">
      <Phone src={home} alt={d.alt} width={300} />
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 64px; align-items: center; }
  h2 span { color: var(--cyan); }
  .stairs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; align-items: end; height: 220px; margin: 44px 0 0; }
  .stair { display: flex; flex-direction: column; align-items: stretch; justify-content: flex-end; height: 100%; text-align: center; }
  .bar { display: block; height: calc(30px + var(--h) * 120px); border-radius: 12px 12px 4px 4px; background: linear-gradient(180deg, rgba(173, 254, 253, 0.9), rgba(32, 223, 217, 0.55)); }
  .stair:nth-child(3) .bar { background: linear-gradient(180deg, #20dfd9, #01abab); }
  .stair:nth-child(4) .bar { background: linear-gradient(180deg, #01abab, #015959); box-shadow: inset 0 0 0 1.5px rgba(173, 254, 253, 0.4); }
  .eq { font-weight: 600; font-size: clamp(15px, 1.7vw, 19px); white-space: nowrap; margin-bottom: 10px; font-variant-numeric: tabular-nums; }
  .lbl { font-size: 13px; color: #c3eeec; margin-top: 8px; }
  .rules { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 36px; }
  .rule { display: flex; gap: 14px; align-items: flex-start; background: rgba(0, 24, 36, 0.22); border: 1px solid rgba(173, 254, 253, 0.16); border-radius: 18px; padding: 18px; }
  .rule p { margin: 4px 0 0; font-size: 15px; color: #d7f3f1; line-height: 1.5; }
  .ic { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; }
  .ic.up { background: var(--teal); color: var(--navy); }
  .ic.down { background: rgba(173, 254, 253, 0.16); color: var(--cyan); }
  .visual { display: flex; justify-content: center; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .visual :global(.phone) { max-width: 260px !important; } }
  @media (max-width: 560px) { .rules { grid-template-columns: 1fr; } .stairs { gap: 8px; height: 200px; } }
</style>
