---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; width?: number; eager?: boolean; class?: string }
const { src, alt, width = 300, eager = false, class: cls } = Astro.props;
---
<div class:list={['phone', cls]} style={`max-width:${width}px`}>
  <div class="screen">
    <Image src={src} alt={alt} widths={[width, width * 2]} sizes={`${width}px`} loading={eager ? 'eager' : 'lazy'} />
  </div>
</div>
