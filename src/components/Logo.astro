---
// Wordmark: the blocky brain from public/logo-dark.svg next to "PlugBrain".
interface Props { size?: number }
const { size = 36 } = Astro.props;
---
<span class="logo">
  <img src="/logo-dark.svg" width={size} height={size} alt="" />
  <span class="word">Plug<b>Brain</b></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; }
  .logo img { margin: -4px; }
  .word { font-weight: 600; font-size: 21px; letter-spacing: -0.02em; color: var(--on-dark); }
  .word b { font-weight: 600; color: var(--teal); }
</style>
